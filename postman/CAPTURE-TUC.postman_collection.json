{
  "info": {
    "name": "CAPTURE TUC",
    "description": "Colección de pruebas para la API de CAPTURE TUC (Proyecto final Backend - CoderHouse). Usa las variables {{baseUrl}}, {{productId}} y {{cartId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "productId", "value": "" },
    { "key": "cartId", "value": "" }
  ],
  "item": [
    {
      "name": "Productos",
      "item": [
        {
          "name": "Listar productos (paginado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve payload paginado', () => pm.expect(body.payload).to.be.an('array'));",
                  "if (body.payload && body.payload.length && !pm.collectionVariables.get('productId')) {",
                  "  pm.collectionVariables.set('productId', body.payload[0]._id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products?limit=10&page=1&sort=asc&query=category:Fotolibros Cuadrados",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "limit", "value": "10" },
                { "key": "page", "value": "1" },
                { "key": "sort", "value": "asc" },
                { "key": "query", "value": "category:Fotolibros Cuadrados" }
              ]
            }
          }
        },
        {
          "name": "Obtener producto por ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve el producto solicitado', () => pm.expect(pm.response.json().payload._id).to.eql(pm.collectionVariables.get('productId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Crear producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve el producto creado', () => pm.expect(body.payload._id).to.be.a('string'));",
                  "pm.collectionVariables.set('productId', body.payload._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Álbum Premium\",\n  \"description\": \"Álbum premium con tapa dura.\",\n  \"code\": \"FC-30X30-D\",\n  \"price\": 25000,\n  \"stock\": 10,\n  \"category\": \"Fotolibros Cuadrados\",\n  \"thumbnails\": [],\n  \"features\": {\n    \"size\": \"30x30 cm\",\n    \"cover\": \"Tapa dura\",\n    \"pages\": 40,\n    \"extraPageCost\": 800\n  }\n}"
            }
          }
        },
        {
          "name": "Actualizar producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Precio actualizado', () => pm.expect(pm.response.json().payload.price).to.eql(27500));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 27500,\n  \"stock\": 10\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Carritos",
      "item": [
        {
          "name": "Crear carrito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Devuelve el carrito creado', () => pm.expect(body.payload._id).to.be.a('string'));",
                  "pm.collectionVariables.set('cartId', body.payload._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/carts",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts"]
            }
          }
        },
        {
          "name": "Obtener carrito (populate)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Devuelve el carrito solicitado', () => pm.expect(pm.response.json().payload._id).to.eql(pm.collectionVariables.get('cartId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/carts/{{cartId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts", "{{cartId}}"]
            }
          }
        },
        {
          "name": "Agregar producto al carrito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('El producto quedó en el carrito', () => {",
                  "  const products = pm.response.json().payload.products;",
                  "  const pid = pm.collectionVariables.get('productId');",
                  "  pm.expect(products.some((i) => (i.product._id || i.product) === pid)).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/carts/{{cartId}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts", "{{cartId}}", "products", "{{productId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2,\n  \"extraPages\": 3\n}"
            }
          }
        },
        {
          "name": "Eliminar producto del carrito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('El producto ya no está en el carrito', () => {",
                  "  const products = pm.response.json().payload.products;",
                  "  const pid = pm.collectionVariables.get('productId');",
                  "  pm.expect(products.some((i) => (i.product._id || i.product) === pid)).to.be.false;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/carts/{{cartId}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts", "{{cartId}}", "products", "{{productId}}"]
            }
          }
        },
        {
          "name": "Reemplazar productos del carrito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('El carrito tiene cantidad 3', () => {",
                  "  const products = pm.response.json().payload.products;",
                  "  const pid = pm.collectionVariables.get('productId');",
                  "  const item = products.find((i) => (i.product._id || i.product) === pid);",
                  "  pm.expect(item.quantity).to.eql(3);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/carts/{{cartId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts", "{{cartId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"products\": [\n    { \"product\": \"{{productId}}\", \"quantity\": 3, \"extraPages\": 0 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Modificar cantidad de un producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('El carrito tiene cantidad 5', () => {",
                  "  const products = pm.response.json().payload.products;",
                  "  const pid = pm.collectionVariables.get('productId');",
                  "  const item = products.find((i) => (i.product._id || i.product) === pid);",
                  "  pm.expect(item.quantity).to.eql(5);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/carts/{{cartId}}/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts", "{{cartId}}", "products", "{{productId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 5\n}"
            }
          }
        },
        {
          "name": "Vaciar carrito",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('El carrito quedó vacío', () => pm.expect(pm.response.json().payload.products).to.have.lengthOf(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/carts/{{cartId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "carts", "{{cartId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Limpieza",
      "item": [
        {
          "name": "Eliminar producto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/products/{{productId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products", "{{productId}}"]
            }
          }
        }
      ]
    }
  ]
}
